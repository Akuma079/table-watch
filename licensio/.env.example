# Base de données (Supabase → Project Settings → Database)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# En local avec docker compose :
# DATABASE_URL="postgresql://licensio:licensio@localhost:5432/licensio"
# DIRECT_URL="postgresql://licensio:licensio@localhost:5432/licensio"

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Côté serveur uniquement : uploads vers Storage et URLs signées. Ne jamais exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=""

# Buckets Storage (privés)
SUPABASE_BUCKET_LICENSES="license-documents"
SUPABASE_BUCKET_MEDIA="project-media"

# File de traitement
REDIS_URL="redis://localhost:6379"

# URL publique de l'app (liens du Passeport de Droits)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mettre à "true" quand Redis et `npm run worker` tournent : les preuves ajoutées au
# coffre-fort sont alors envoyées à l'OCR (simulé).
PROCESSING_QUEUE_ENABLED="false"

# Stripe (facultatif : laissés vides, tous les espaces restent en plan Gratuit)
# Clé secrète (sk_live_… ou sk_test_…) et secret du webhook (whsec_…)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ID (price_…) des prix mensuels TTC : Creator 19 €/mois, Agence 79 €/mois
STRIPE_PRICE_CREATOR=""
STRIPE_PRICE_AGENCY=""
# "true" une fois Stripe Tax activé (prix avec « tax_behavior » inclusive)
STRIPE_TAX_ENABLED="false"

# Emails d'invitation via Resend (facultatif : sans clé, le lien est à transmettre à la main)
RESEND_API_KEY=""
EMAIL_FROM="Licensio <invitations@votre-domaine.com>"

# Secret de la tâche planifiée de nettoyage des fichiers orphelins (/api/cron/storage-cleanup)
CRON_SECRET=""

# ── Tests et outils (laisser vides en production) ──
# Serveurs simulés (stripe-mock, faux serveur d'emails) :
# STRIPE_API_BASE="http://localhost:12111"
# RESEND_API_BASE="http://localhost:54321"
# Compte cible de `npm run db:seed` :
# SEED_EMAIL="vous@exemple.com"
