# Base de données (Supabase → Project Settings → Database)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# En local avec docker compose :
# DATABASE_URL="postgresql://licensio:licensio@localhost:5432/licensio"
# DIRECT_URL="postgresql://licensio:licensio@localhost:5432/licensio"

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Côté serveur uniquement : uploads vers Storage et URLs signées. Ne jamais exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=""

# Buckets Storage (privés)
SUPABASE_BUCKET_LICENSES="license-documents"
SUPABASE_BUCKET_MEDIA="project-media"

# File de traitement
REDIS_URL="redis://localhost:6379"

# URL publique de l'app (liens du Passeport de Droits)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mettre à "true" quand Redis et `npm run worker` tournent : les preuves ajoutées au
# coffre-fort sont alors envoyées à l'OCR (simulé).
PROCESSING_QUEUE_ENABLED="false"

# Stripe (facultatif : sans clé, tous les espaces restent en plan Gratuit)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# ID du prix mensuel du plan Agence (79 €/mois TTC), créé dans le tableau de bord Stripe
STRIPE_PRICE_AGENCY="price_..."
# ID du prix mensuel du plan Creator (19 €/mois TTC)
STRIPE_PRICE_CREATOR="price_..."
# TVA calculée par Stripe Tax (prix TTC : « tax_behavior » inclusive sur les deux prix)
STRIPE_TAX_ENABLED="true"

# Emails d'invitation via Resend (facultatif : sans clé, le lien est à transmettre à la main)
RESEND_API_KEY=""
EMAIL_FROM="Licensio <invitations@votre-domaine.com>"

# Secret de la tâche planifiée de nettoyage des fichiers orphelins (/api/cron/storage-cleanup)
CRON_SECRET=""
